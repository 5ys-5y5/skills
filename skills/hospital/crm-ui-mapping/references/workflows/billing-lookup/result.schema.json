{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "billing-lookup information",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "minLength": 1
    },
    "bill_id": {
      "type": "string",
      "minLength": 1
    },
    "total": {
      "type": "number"
    },
    "paid": {
      "type": "number"
    },
    "balance": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "patient_id",
    "bill_id"
  ],
  "additionalProperties": true
}
